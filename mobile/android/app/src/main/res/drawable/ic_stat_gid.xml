<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar notification icon.

  Android masks the small icon by its ALPHA channel and paints the result in
  the system's own colour, so anything with real colours in it — the launcher
  icon, for instance — arrives as a featureless white blob. Only the silhouette
  survives, which is why this is a flat white shape on transparency and nothing
  more.

  minSdk is 23, so a VectorDrawable is safe here (small-icon vector support
  landed in API 21).

  The mark is the brand's "done" check inside a ring: legible at the ~18dp the
  status bar actually renders, and distinguishable from the dozens of generic
  bells already in a user's shade.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Ring. evenOdd so the inner circle knocks a hole through the outer one
         instead of filling it in (nonzero winding would render a solid disc). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,1.5 C17.799,1.5 22.5,6.201 22.5,12 C22.5,17.799 17.799,22.5 12,22.5 C6.201,22.5 1.5,17.799 1.5,12 C1.5,6.201 6.201,1.5 12,1.5 Z M12,3.9 C7.526,3.9 3.9,7.526 3.9,12 C3.9,16.474 7.526,20.1 12,20.1 C16.474,20.1 20.1,16.474 20.1,12 C20.1,7.526 16.474,3.9 12,3.9 Z" />

    <!-- Check. Weighted heavier than a hairline so it holds together once the
         system scales it down. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.45,16.05 L6.4,12.0 L8.11,10.29 L10.45,12.63 L15.89,7.19 L17.6,8.9 Z" />
</vector>
