<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately identical to values/styles.xml.

  The app does not follow the system's dark mode (see AppThemeChoice), so a
  phone in system dark must NOT get a black launch window — that would flash
  black and then hand over to a light app. The launch window matches what the
  app actually opens as, which is light.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
