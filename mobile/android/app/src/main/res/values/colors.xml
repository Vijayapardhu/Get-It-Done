<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The plate the adaptive launcher icon sits on.

      AppColors.blue900 from lib/design/tokens/colors.dart — the darkest step of
      the brand blue, so the badge's own lighter gradient lifts off it instead
      of dissolving into it.
    -->
    <color name="ic_launcher_background">#14285C</color>

    <!--
      The window Android paints before Flutter starts. AppColors.n0 — the same
      white the light theme uses for its surfaces — because the app is a light
      app and the very first pixel should already say so.
    -->
    <color name="launch_background">#FFFFFF</color>
</resources>
