server {
    listen 80;
    listen [::]:80;
    server_name fed.getitdone.vijayapardhu.tech;

    root /var/www/fed-getitdone;
    index index.html;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
