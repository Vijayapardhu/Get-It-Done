NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://getitdone:getitdone@localhost:5432/getitdone
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# How long a session lasts before the customer has to sign in again.
#
# The access token is refreshed transparently by the app, so its length is
# invisible. The refresh token is single-use and rotates on every exchange, and
# lives in the phone's keystore -- which is what makes a year-long default
# reasonable. Signing out, "sign out of all devices" and a password reset all
# revoke immediately regardless.
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=365
AI_SERVICE_URL=http://localhost:8001
USE_MOCK_DB=false
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Reverse proxies in front of this process. 0 = reached directly; 1 = the usual
# single nginx terminating TLS. Left at 0 behind a proxy, every request looks
# like it came from the proxy, so all callers share one rate-limit bucket and
# the audit trail records the proxy's address for every event.
TRUST_PROXY_HOPS=0

LOG_LEVEL=info
METRICS_ENABLED=true
WS_ENABLED=true

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=getitdone
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
STORAGE_PROVIDER=minio
MALWARE_SCAN_API=

# Error aggregation. Empty means Sentry is OFF and the process logs that once
# at boot -- the same shape as the Razorpay and SMS adapters. Stack traces then
# exist only in the pino output.
# SENTRY_RELEASE should be the git sha, set by CI, or every deploy groups
# together and "when did this start?" has no answer.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Payment gateway webhook verification ────────────────────────────────────
# Inbound webhooks are HMAC-verified against these. An empty secret means the
# provider is NOT configured and its webhooks are rejected rather than trusted.
# Razorpay. KEY_ID is publishable and is sent to the mobile app to open
# checkout; KEY_SECRET signs checkout responses and must never leave the
# server. With these unset the backend issues SIMULATED order ids so the
# payment flow can be developed without credentials — it refuses to do that
# when NODE_ENV=production, so a live deployment cannot silently take fake
# payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
# Local development only. The app refuses to start with this on in production.
ALLOW_UNSIGNED_WEBHOOKS=false

# ─── Revenue split (platform + cooperative + welfare must be < 1) ────────────
# The worker takes the remainder, so the four shares always sum to the gross.
PLATFORM_FEE_RATE=0.05
COOPERATIVE_SHARE_RATE=0.10
WELFARE_FUND_RATE=0.02
TAX_RATE=0.18

# ─── Background jobs ─────────────────────────────────────────────────────────
# Acceptance failover, emergency escalation, recurring generation, settlement
# batching and outbox draining. Set JOBS_ENABLED=false on API instances and run
# `npm run worker` separately to keep dispatch off the request path.
JOBS_ENABLED=true
JOB_POLL_INTERVAL_MS=5000
JOB_BATCH_SIZE=10
# Blueprint 5.4: seconds a worker has to accept before the job is reassigned.
WORKER_ACCEPT_TIMEOUT_SECONDS=45
MAX_ASSIGNMENT_ATTEMPTS=5

# ─── SMS delivery (unused today) ─────────────────────────────────────────────
# Nothing in the running system sends an SMS. Sign-in is email+password or
# Google, and the booking handshake codes are shown in both apps. These stay
# configured because the provider adapter is still here for the obvious next
# use -- reaching a worker who has no data connection -- and because the MSG91
# DLT plumbing is the expensive part to rebuild. Leaving them blank is fine.
SMS_PROVIDER=console

# MSG91 (recommended for India — better carrier delivery, DLT compliant).
# The message body lives in the DLT-approved template, not in our code.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Twilio (fallback).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Google Sign-In ──────────────────────────────────────────────────────────
# An ID token's audience is whichever client id requested it, and Android, iOS
# and web each have their own. List every acceptable id, comma separated, or
# verification rejects legitimate tokens from the other platforms.
# The mobile app passes --dart-define=GOOGLE_SERVER_CLIENT_ID=<web client id>.
GOOGLE_CLIENT_IDS=

# Timezone Configuration (IST - Indian Standard Time)
TZ=Asia/Kolkata

# Server-side Maps key for geocoding, places, distance and static map tiles.
# A SERVER key -- it is never sent to the app. The app calls /maps/* and the
# booking map proxy instead, so the key never leaves this process. Restrict it
# by IP, not by app package.
GOOGLE_MAPS_API_KEY=your-google-maps-server-key
